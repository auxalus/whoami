# ==============================================================================
# 197 HISTORIAS ILUSTRADAS // ENVIRONMENT CONFIGURATION
# ==============================================================================
# Paste your Google OAuth 2.0 Client Credentials below.
#
# 1. GOOGLE_CLIENT_ID: Used by frontend Google Identity Services (GSI)
# 2. GOOGLE_CLIENT_SECRET: Kept securely for backend server token verification (never exposed to browser)
#
# After modifying this file, run:
#   node build_index.js
# ==============================================================================

GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# Vite / React standard prefix alias
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
